# BISILE backend environment template for local development or Render.
# Never commit real values. Do not prefix server secrets with VITE_.

NODE_ENV=production
PORT=5000

FRONTEND_URL=https://bisile.co.za
CLIENT_URL=https://bisile.co.za
CORS_ORIGINS=https://bisile.co.za,https://www.bisile.co.za

MONGODB_URI=
MONGODB_DB=bisile
MONGODB_DB_NAME=bisile
MONGODB_DATABASE=bisile

JWT_SECRET=
BACKEND_WAKE_TOKEN=

# Admin reset values are secrets/configuration, not source-code credentials.
RESET_ADMIN_CURRENT=admin
RESET_ADMIN_USERNAME=admin
RESET_ADMIN_EMAIL=studio@bisile.co.za
RESET_ADMIN_PASSWORD=

PAYSTACK_SECRET_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@bisile.co.za
RESEND_FROM_NAME=BISILE
FROM_EMAIL=orders@bisile.co.za
ADMIN_NOTIFICATION_EMAIL=studio@bisile.co.za

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
