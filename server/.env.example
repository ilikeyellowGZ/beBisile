# BISILE Render backend environment variables
# Copy this file to `server/.env` for local backend testing.
# On Render, add these in the Web Service environment settings.

# NODE_ENV
# What it does: Controls whether the backend runs in development or production mode.
NODE_ENV=development

# PORT
# What it does: Local backend port. Render provides PORT automatically in production.
PORT=5000

# FRONTEND_URL
# What it does: Frontend URL allowed by CORS. In production, set this to the DirectAdmin frontend URL.
FRONTEND_URL=http://localhost:5173

# TEMP_NETLIFY_URL
# What it does: Temporary Netlify preview URL allowed by CORS during testing.
TEMP_NETLIFY_URL=

# CLIENT_URL
# What it does: Optional legacy redirect URL for Stripe success/cancel redirects.
# Leave blank to use FRONTEND_URL.
CLIENT_URL=

# CORS_ORIGINS
# What it does: Optional comma-separated extra origins, for example preview URLs.
CORS_ORIGINS=

# SERVER_URL
# What it does: Public Render backend URL, if needed for webhooks or generated links.
SERVER_URL=https://your-render-backend.onrender.com

# MONGODB_URI
# What it does: Secret MongoDB connection string used by the backend.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bisile

# MONGODB_DB
# What it does: MongoDB database name.
MONGODB_DB=bisile

# DATABASE_URL
# What it does: Optional generic database URL if the backend is migrated away from MongoDB later.
# This project currently uses MONGODB_URI.
DATABASE_URL=

# JWT_SECRET
# What it does: Secret used for authentication tokens. Use 32+ characters.
JWT_SECRET=change-me-32-plus-characters

# STRIPE_SECRET_KEY
# What it does: Secret Stripe backend key used to create checkout sessions. Never expose this to frontend code.
STRIPE_SECRET_KEY=sk_test_or_live_key

# STRIPE_WEBHOOK_SECRET
# What it does: Secret Stripe webhook signing key used to verify Stripe events.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Optional email provider settings.
RESEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=orders@your-final-domain.co.za

# Optional image upload settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
