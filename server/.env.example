# BISILE Render/Express backend environment variables
# Copy to `server/.env` for local backend testing, or configure these in Render.
# Secret values must never be exposed as VITE_ variables.

NODE_ENV=development
PORT=5000

MONGODB_URI=
MONGODB_DB_NAME=bisile
MONGODB_DB=bisile

JWT_SECRET=change-me-32-plus-characters

PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
FROM_EMAIL=orders@bisile.co.za

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
TEMP_NETLIFY_URL=
SERVER_URL=
CORS_ORIGINS=
