# BISILE frontend + local Netlify Functions environment
# Copy to `.env` for local development. Never commit real `.env` values.
#
# VITE_ variables are public and may be exposed to browser code.
# Variables without VITE_ are server-only secrets for Netlify Functions or the local Express API.

# Public frontend variables
VITE_SITE_NAME=BISILE
VITE_SITE_URL=http://localhost:3000
VITE_API_URL=
VITE_API_BASE_URL=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_CHECKOUT_API_URL=
VITE_PAYSTACK_VERIFY_API_URL=
VITE_WHATSAPP_NUMBER=27769217648
VITE_CONTACT_EMAIL=bisilebeautyandmakeup@mail.com
VITE_INSTAGRAM_URL=https://www.instagram.com/be_bisile/
VITE_PINTEREST_URL=https://za.pinterest.com/be_bisile/
VITE_ENABLE_VIDEO_HERO=true
VITE_LOCAL_API_PROXY_TARGET=http://127.0.0.1:5000

# Server-only values
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
TEMP_NETLIFY_URL=
SERVER_URL=
CORS_ORIGINS=

MONGODB_URI=
MONGODB_DB_NAME=bisile
MONGODB_DB=bisile
MONGODB_DATABASE=bisile

JWT_SECRET=change-me-32-plus-characters
BACKEND_WAKE_TOKEN=
ADMIN_JWT_SECRET=change-me-32-plus-characters
ADMIN_PASSWORD_SECRET=change-me-32-plus-characters

SEED_ADMIN_USERNAME=bisile
SEED_ADMIN_EMAIL=studio@bisile.co.za
SEED_ADMIN_PASSWORD=
RESET_ADMIN_CURRENT=admin
