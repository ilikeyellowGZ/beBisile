# BISILE frontend environment variables
# Copy this file to `.env` at the project root for local frontend development.
# Do not commit real secrets. Vite exposes only variables that start with VITE_.

# VITE_SITE_NAME
# What it does: Public website name used in metadata, browser titles, and sharing text.
VITE_SITE_NAME=BISILE

# VITE_SITE_URL
# What it does: Final public frontend URL used for SEO, sharing links, canonical URLs, and metadata.
# Use the Netlify preview URL temporarily, then replace it with the DirectAdmin domain later.
VITE_SITE_URL=https://bisile.co.za/

# VITE_API_BASE_URL
# What it does: Render backend URL used by the frontend for API routes.
# Example: https://your-service-name.onrender.com
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# VITE_PAYSTACK_CHECKOUT_API_URL
# What it does: Optional frontend override for the Paystack checkout initialization endpoint.
# Leave blank on Netlify to use /.netlify/functions/create-paystack-transaction.
# Leave blank with VITE_API_BASE_URL set to use /api/checkout/create-paystack-transaction on Render.
VITE_PAYSTACK_CHECKOUT_API_URL=

# VITE_PAYSTACK_VERIFY_API_URL
# What it does: Optional frontend override for the Paystack transaction verification endpoint.
# Leave blank on Netlify to use /.netlify/functions/verify-paystack-transaction.
# Leave blank with VITE_API_BASE_URL set to use /api/checkout/verify-paystack-transaction on Render.
VITE_PAYSTACK_VERIFY_API_URL=

# VITE_WHATSAPP_NUMBER
# What it does: Public WhatsApp number used for product enquiries, orders, and contact buttons.
# Use digits only, including country code.
VITE_WHATSAPP_NUMBER=27769217648

# VITE_CONTACT_EMAIL
# What it does: Public contact email displayed on the website.
VITE_CONTACT_EMAIL=bisilebeautyandmakeup@mail.com

# VITE_INSTAGRAM_URL
# What it does: Instagram link used in footer/social buttons.
VITE_INSTAGRAM_URL=https://www.instagram.com/be_bisile/

# VITE_PINTEREST_URL
# What it does: Pinterest link used in footer/social buttons.
VITE_PINTEREST_URL=https://za.pinterest.com/be_bisile/

# VITE_ENABLE_VIDEO_HERO
# What it does: Controls whether desktop hover videos are enabled. Mobile/tablet always use static images.
VITE_ENABLE_VIDEO_HERO=true

# Temporary Netlify Functions and local server-only values
# These do not use VITE_ and must not be exposed to browser code.

# CLIENT_URL
# What it does: Frontend URL used by Netlify Functions for Paystack return redirects.
CLIENT_URL=http://localhost:5173

# MONGODB_URI
# What it does: Secret MongoDB connection string for Netlify Functions or the Express backend.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/bisile?retryWrites=true&w=majority"

# MONGODB_DB
# What it does: MongoDB database name used by the Express backend.
MONGODB_DB=bisile

# MONGODB_DATABASE
# What it does: MongoDB database name used by older Netlify helpers. Keep aligned with MONGODB_DB.
MONGODB_DATABASE=bisile

# JWT_SECRET
# What it does: Secret used by the Express backend to sign auth tokens. Use 32+ characters.
JWT_SECRET=change-me-32-plus-characters

# ADMIN_JWT_SECRET
# What it does: Secret used by Netlify admin functions to sign dashboard tokens.
ADMIN_JWT_SECRET=change-me-32-plus-characters

# ADMIN_PASSWORD_SECRET
# What it does: Secret salt input used when hashing dashboard admin passwords.
ADMIN_PASSWORD_SECRET=change-me-32-plus-characters

# PAYSTACK_SECRET_KEY
# What it does: Secret backend Paystack key used to initialize, verify, and validate webhook payments. Never expose this to frontend code.
PAYSTACK_SECRET_KEY=sk_test_or_live_key

# Optional server settings used by the Express backend if run from this root env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
TEMP_NETLIFY_URL=
SERVER_URL=
CORS_ORIGINS=

# Optional provider settings.
RESEND_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=orders@your-final-domain.co.za
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
