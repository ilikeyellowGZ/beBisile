# BISILE production/local environment template
# Copy to .env locally. Never commit a real .env file.
# VITE_* values are public. All other values are server-only.

# Frontend / public values
VITE_SITE_NAME=BISILE
VITE_SITE_URL=https://bisile.co.za
VITE_API_BASE_URL=https://bebisile.onrender.com
# Legacy alias; leave blank when VITE_API_BASE_URL is set.
VITE_API_URL=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_CHECKOUT_API_URL=
VITE_PAYSTACK_VERIFY_API_URL=
VITE_WHATSAPP_NUMBER=27769217648
VITE_CONTACT_EMAIL=bisilebeautyandmakeup@gmail.com
VITE_INSTAGRAM_URL=https://www.instagram.com/be_bisile/
VITE_PINTEREST_URL=https://za.pinterest.com/be_bisile/
VITE_ENABLE_VIDEO_HERO=true
VITE_LOCAL_API_PROXY_TARGET=http://127.0.0.1:5000

# Backend runtime / CORS
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://bisile.co.za
CLIENT_URL=https://bisile.co.za
CORS_ORIGINS=https://bisile.co.za,https://www.bisile.co.za

# Database: use the bisile database only
MONGODB_URI=
MONGODB_DB=bisile
MONGODB_DB_NAME=bisile
MONGODB_DATABASE=bisile

# Authentication / wake token secrets. Generate unique values of 32+ characters.
JWT_SECRET=
BACKEND_WAKE_TOKEN=

# Admin bootstrap/reset values. Passwords belong in .env/Render only, never in this file.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=studio@bisile.co.za
SEED_ADMIN_PASSWORD=
RESET_ADMIN_CURRENT=admin
RESET_ADMIN_USERNAME=admin
RESET_ADMIN_EMAIL=studio@bisile.co.za
RESET_ADMIN_PASSWORD=

# Paystack server secret; never use the public key here.
PAYSTACK_SECRET_KEY=

# Resend. The sender must be an address on the verified bisile.co.za domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@bisile.co.za
RESEND_FROM_NAME=BISILE
# Backwards-compatible alias accepted by the backend; prefer RESEND_FROM_EMAIL.
FROM_EMAIL=orders@bisile.co.za
ADMIN_NOTIFICATION_EMAIL=studio@bisile.co.za

# Optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
